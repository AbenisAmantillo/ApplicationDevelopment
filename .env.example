# Copy to `.env.local` (gitignored). Never put DATABASE_URL or MySQL credentials here.
# React Native reads this at bundle time via react-native-dotenv.
# Physical phone: use your computer's LAN IPv4 and Symfony backend port, not localhost.
API_BASE_URL=http://192.168.1.50:8080
# VITE_API_BASE_URL and NEXT_PUBLIC_API_BASE_URL are also accepted aliases.
# Optional: WebSocket origin (defaults to ws/wss derived from API_BASE_URL)
# WS_BASE_URL=ws://192.168.1.50:8080
# WS_PATH=/ws
GOOGLE_WEB_CLIENT_ID=670659193824-rr2o3n7i0ad162da29ktpubpqbj293c4.apps.googleusercontent.com
